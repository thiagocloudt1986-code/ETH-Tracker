# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ETHERSCAN_API_KEY: Free tier from etherscan.io (3 calls/sec, 100k/day)
ETHERSCAN_API_KEY="MY_ETHERSCAN_API_KEY"

# COINGLASS_API_KEY: Free tier from coinglass.com (30 req/min)
COINGLASS_API_KEY="MY_COINGLASS_API_KEY"
